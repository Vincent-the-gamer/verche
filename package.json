{
  "name": "verche",
  "version": "0.1.6",
  "type": "module",
  "description": "Quickly check versions of your toolchains.",
  "author": "Vincent-the-gamer",
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "files": [
    "dist",
    "*.d.ts"
  ],
  "exports": {
    ".": {
      "require": "./dist/index.cjs",
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.mts"
    }
  },
  "bin": {
    "verche": "bin/verche.js"
  },
  "typesVersions": {
    "*": {
      ".": [
        "./dist/index.d.mts"
      ]
    }
  },
  "scripts": {
    "tsx": "tsx",
    "build": "tsdown",
    "test": "vitest",
    "dep": "taze major -I",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "knip": "knip"
  },
  "license": "MIT",
  "homepage": "https://github.com/Vincent-the-gamer/verche#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vincent-the-gamer/verche.git"
  },
  "bugs": {
    "url": "https://github.com/Vincent-the-gamer/verche/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.com",
    "access": "public"
  },
  "sideEffects": false,
  "devDependencies": {
    "@types/node": "^26.6.6",
    "knip": "^6.46.1",
    "oxlint": "^1.94.0",
    "taze": "^21.3.0",
    "tsdown": "^0.23.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "axios": "^1.21.1",
    "cac": "^7.1.1",
    "cheerio": "^1.2.0",
    "consola": "^3.4.2",
    "plist": "^5.1.2",
    "restore-cursor": "^5.1.0"
  }
}
